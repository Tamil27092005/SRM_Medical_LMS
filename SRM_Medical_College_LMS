     */
    function formatMedicalMarkdown(text) {
      if (!text) return "";
      let html = text
        // Headers
        .replace(/【(.*?)】/g, '<h4 style="color:var(--blue);font-size:18px;margin:18px 0 10px 0;font-family:\'Bricolage Grotesque\';border-bottom:2px solid var(--blueLight);padding-bottom:5px;">$1</h4>')
        .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
        // Tables (Basic support for the wall of text issue)
        .replace(/\|(.*?)\|/g, (match) => {
          if (match.includes('---')) return ""; // Skip separator rows
          return match.split('|').filter(c => c.trim()).map(c => `<div style="padding:10px;border-bottom:1px solid #e2e8f0;font-size:15px;">${c.trim()}</div>`).join('');
        })
        // Lists
        .replace(/^\s*[-*•]\s+(.*)/gm, '<li style="margin-left:20px;margin-bottom:6px;list-style-type:disc;">$1</li>')
        // Actions
        .replace(/\*(.*?)\*/g, '<em style="color:var(--text3); font-style:italic;">*$1*</em>');

      // Wrap lists
      if (html.includes('<li')) {
        html = html.replace(/(<li.*<\/li>)/gms, '<ul style="margin:10px 0;">$1</ul>');
      }

      return html;
    }

    async function callGroqAI(messages, type = "general", systemMsg = "", isJson = false, overrideKey = null) {
      const targetUrl = "https://api.groq.com/openai/v1/chat/completions";

      // Connection strategy: Direct First -> Proxy bridges
      const strategies = [
        (url) => url, // ⚡ DIRECT (Fastest, requires extension)
        (url) => "https://corsproxy.io/?" + encodeURIComponent(url), // Proxy A
        (url) => "https://api.allorigins.win/raw?url=" + encodeURIComponent(url), // Proxy B
        (url) => "https://api.codetabs.com/v1/proxy?quest=" + encodeURIComponent(url) // Proxy C
      ];

      let lastError = null;

      // Try each connection strategy
      for (let sIdx = 0; sIdx < strategies.length; sIdx++) {
        const proxiedUrl = strategies[sIdx](targetUrl);
        const strategyName = sIdx === 0 ? "Direct" : `Proxy Bridge ${sIdx}`;

        // For each strategy, try the keys (rotation support)
        for (let kAttempt = 0; kAttempt < AI_CONFIG.keys.length; kAttempt++) {
          const keyObj = AI_CONFIG.keys[currentKeyIdx];

          try {
            console.log(`[AI] ${strategyName} using ${keyObj.id}...`);

            const apiKey = overrideKey || keyObj.val;
            const apiModel = (type === 'docbot') ? "openai/gpt-oss-120b" : AI_CONFIG.model;

            const response = await fetch(proxiedUrl, {
              method: "POST",
              headers: {
                "Authorization": `Bearer ${apiKey}`,
                "Content-Type": "application/json"
              },
              body: JSON.stringify({
                model: apiModel,
                messages: systemMsg ? [{ role: "system", content: systemMsg }, ...messages] : messages,
                temperature: isJson ? 0.7 : 1,
                max_tokens: 1500, // Increased for detailed tutor answers
                stream: false,
                ...(isJson && { response_format: { type: "json_object" } })
              })
            });

            // HANDLE RATE LIMIT (429)
            if (response.status === 429) {
              console.warn(`[AI] ${keyObj.id} rate limited. Rotating...`);
              keyObj.limited = true;
              updateAIStatus('limited');
              currentKeyIdx = (currentKeyIdx + 1) % AI_CONFIG.keys.length; // Switch to next key
              continue; // Retry SAME strategy with NEXT key
            }

            if (!response.ok) {
              const errData = await response.json().catch(() => ({}));
              throw new Error(errData.error?.message || `API Error ${response.status}`);
            }

            const data = await response.json();
            if (!data.choices?.[0]) throw new Error("Empty AI response");

            updateAIStatus('online');
            keyObj.errors = 0;
            keyObj.limited = false;
            return data.choices[0].message.content;

          } catch (err) {
            console.warn(`[AI] ${strategyName} failed:`, err.message);
            lastError = err;
            keyObj.errors++;

            // If it's a real API error (401, 400, etc) and not a network failure, don't keep trying strategies
            if (err.message.includes("API Error") && !err.message.includes("429")) break;

            // If network "Failed to fetch", move to next strategy
            if (err.message.includes("Failed to fetch")) break;
          }
        }
      }

      updateAIStatus('offline');
      // Specialized user feedback
      if (lastError?.message.includes("Failed to fetch")) {
        throw new Error("🚀 Connection Refused. Please enable your 'CORS Unblock' extension or try a different network.");
      }
      throw lastError || new Error("AI Connectivity Error");
    }

    // ══════════════════════════════════════════════
