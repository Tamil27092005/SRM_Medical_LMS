    function initVideo() {
      const comp = state.currentCompetency;
      const subj = state.currentSubject;

      const frameContainer = document.getElementById('video-frame-container');
      const iframe = document.getElementById('video-iframe');
      const playOverlay = document.getElementById('play-overlay');
      const visual = document.querySelector('.video-visual');
      const center = document.querySelector('.video-center');
      const dotsDeco = visual ? visual.nextElementSibling : null;

      const fakeControls = document.querySelector('.video-controls');
      const bottomBar = document.querySelector('.video-area > div:last-child');

      if (comp && comp.videoUrl) {
        iframe.src = comp.videoUrl;
        frameContainer.style.display = 'block';
        playOverlay.style.display = 'none';
        if (visual) visual.style.display = 'none';
        if (center) center.style.display = 'none';
        if (dotsDeco) dotsDeco.style.display = 'none';
        if (fakeControls) fakeControls.style.display = 'none';
        if (bottomBar) bottomBar.style.display = 'none';

        // Remove any leftover overlay from previous session
        const oldOverlay = document.getElementById('iframe-play-overlay');
        if (oldOverlay) oldOverlay.remove();

        document.getElementById('video-complete-btn').style.display = 'none';
        state._videoWatched = false;

        // Clear any previous timers
        if (state._videoTimer) { clearInterval(state._videoTimer); state._videoTimer = null; }

        document.getElementById('video-complete-btn').style.display = 'none';
        state._videoWatched = false;

        // Use exact videoDuration from competency data (e.g. AN.1 = 80s, MI.1 = 960s)
        const totalSec = comp.videoDuration || 300;
        let elapsed = 0;
        const progressEl = document.getElementById('vid-sidebar-progress');

        state._videoTimer = setInterval(() => {
          elapsed++;
          const remaining = Math.max(0, totalSec - elapsed);
          const pct = Math.min(100, (elapsed / totalSec) * 100);

          // Show live countdown: "2:15 remaining" → "0:00 — Done!"
          if (progressEl) {
            if (remaining > 0) {
              const m = String(Math.floor(remaining / 60)).padStart(2, '0');
              const s = String(remaining % 60).padStart(2, '0');
              progressEl.textContent = `⏱ ${m}:${s} remaining`;
            } else {
              progressEl.textContent = '✅ Video complete!';
            }
          }

