    function toggleGlobalVoice() {
      VOICE.active = !VOICE.active;
      initVoices(); // Refresh voices on toggle
      const ctrl = document.getElementById('global-voice-ctrl');
      if (ctrl) ctrl.classList.toggle('active', VOICE.active);
      const lbl = document.getElementById('voice-status-lbl');
      if (lbl) lbl.textContent = VOICE.active ? "Voice Engaged" : "Voice Off";

      if (VOICE.active) {
        console.log("SRM Voice: Engine Activated");
        speakText("Voice Engine Active", "female"); // Audio Unlock
      } else {
        window.speechSynthesis.cancel();
        if (VOICE.activeAudio) {
          VOICE.activeAudio.pause();
          VOICE.activeAudio = null;
        }
      }
    }

