<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SRM eLEARN – Medical College, Chennai</title>
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,600;12..96,700;12..96,800&display=swap"
    rel="stylesheet" />
  <script src="https://meet.jit.si/external_api.js"></script>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    :root {
      --blue: #1e3a8a;
      --blue2: #1d4ed8;
      --blue3: #3b82f6;
      --blueLight: #eff6ff;
      --green: #065f46;
      --greenLight: #ecfdf5;
      --greenMid: #10b981;
      --purple: #7c3aed;
      --purpleLight: #f5f3ff;
      --amber: #b45309;
      --amberLight: #fffbeb;
      --red: #dc2626;
      --redLight: #fef2f2;
      --sky: #0ea5e9;
      --skyLight: #f0f9ff;
      --bg: #f0f4f8;
      --white: #fff;
      --border: #e2e8f0;
      --border2: #cbd5e1;
      --text: #0f172a;
      --text2: #475569;
      --text3: #94a3b8;
      --r: 12px;
      --r2: 18px;
      --r3: 28px;
      --sh: 0 1px 3px rgba(0, 0, 0, .08), 0 1px 2px rgba(0, 0, 0, .06);
      --sh2: 0 10px 25px rgba(0, 0, 0, .1), 0 4px 10px rgba(0, 0, 0, .06);
      --sh3: 0 20px 60px rgba(0, 0, 0, .15);
    }

    body {
      font-family: 'Inter', sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
      overflow: hidden;
    }

    .screen {
      display: none;
      height: 100vh;
      width: 100vw;
      overflow: hidden;
    }

    .screen.active {
      display: flex;
    }

    /* ══ NAV ══ */
    .nav-header {
      height: 58px;
      display: flex;
      align-items: center;
      padding: 0 24px;
      background: var(--white);
      border-bottom: 1px solid var(--border);
      gap: 14px;
      flex-shrink: 0;
      z-index: 50;
    }

    .nav-logo {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .nav-logo-icon {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      background: linear-gradient(135deg, #1e3a8a, #3b82f6);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .nav-logo-name {
      font-family: 'Bricolage Grotesque';
      font-weight: 700;
      font-size: 14px;
      color: #1e3a8a;
      line-height: 1;
    }

    .nav-logo-sub {
      font-size: 10px;
      color: var(--text3);
      line-height: 1;
    }

    .nav-sep {
      width: 1px;
      height: 24px;
      background: var(--border);
    }

    .nav-back {
      display: flex;
      align-items: center;
      gap: 6px;
      color: var(--blue);
      background: #eff6ff;
      border: none;
      padding: 6px 12px;
      border-radius: 8px;
      font-family: 'Inter';
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      transition: .15s;
    }

    .nav-back:hover {
      background: #dbeafe;
    }

    .nav-breadcrumb {
      display: flex;
      align-items: center;
      gap: 4px;
      font-size: 12px;
      color: var(--text3);
    }

    .nav-breadcrumb span {
      cursor: pointer;
      color: var(--blue);
      font-weight: 500;
    }

    .nav-breadcrumb span:last-child {
      color: var(--text2);
      cursor: default;
      font-weight: 400;
    }

    .nav-spacer {
      flex: 1;
    }

    .nav-right {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .nav-bell {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: #f1f5f9;
      border: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      transition: .15s;
    }

    .nav-bell:hover {
      background: #e2e8f0;
    }

    .nav-bell-badge {
      position: absolute;
      top: -2px;
      right: -2px;
      width: 15px;
      height: 15px;
      border-radius: 50%;
      background: var(--red);
      border: 2px solid white;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 8px;
      color: white;
      font-weight: 700;
    }

    .nav-user {
      display: flex;
      align-items: center;
      gap: 8px;
      background: #eff6ff;
      border: 1px solid #dbeafe;
      padding: 5px 12px 5px 5px;
      border-radius: 99px;
    }

    .nav-avatar {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: linear-gradient(135deg, #1e3a8a, #3b82f6);
      display: flex;
      align-items: center;
      justify-content: center;
      color: white;
      font-size: 11px;
      font-weight: 700;
    }

    .nav-username {
      font-size: 12px;
      font-weight: 600;
      color: #1e3a8a;
    }

    .nav-logout {
      width: 32px;
      height: 32px;
      border-radius: 50%;
      background: #fef2f2;
      border: none;
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: .15s;
    }

    .nav-logout:hover {
      background: #fee2e2;
    }

    /* ══ LOGIN ══ */
    #screen-login {
      flex-direction: row;
    }

    .login-left {
      width: 55%;
      height: 100%;
      position: relative;
      overflow: hidden;
      flex-shrink: 0;
    }

    .login-left img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .login-left-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(145deg, rgba(15, 23, 42, .92), rgba(29, 78, 216, .78), rgba(5, 150, 105, .55));
    }

    .login-left-content {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 52px;
    }

    .login-brand {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .login-brand-icon {
      width: 52px;
      height: 52px;
      border-radius: 16px;
      background: rgba(255, 255, 255, .18);
      backdrop-filter: blur(10px);
      border: 1.5px solid rgba(255, 255, 255, .3);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .login-brand-text {
      color: white;
      font-family: 'Bricolage Grotesque';
      font-weight: 700;
      font-size: 24px;
    }

    .login-brand-sub {
      color: rgba(165, 214, 255, .85);
      font-size: 13px;
    }

    .login-hero {
      padding-bottom: 20px;
    }

    .login-hero h1 {
      font-family: 'Bricolage Grotesque';
      font-size: 46px;
      color: white;
      line-height: 1.15;
      margin-bottom: 18px;
    }

    .login-hero h1 em {
      color: #7dd3fc;
      font-style: italic;
    }

    .login-hero p {
      color: rgba(255, 255, 255, .72);
      font-size: 15px;
      line-height: 1.65;
      max-width: 390px;
    }

    .login-features {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .login-feat {
      display: flex;
      align-items: center;
      gap: 14px;
    }

    .login-feat-icon {
      width: 44px;
      height: 44px;
      border-radius: 13px;
      background: rgba(255, 255, 255, .14);
      border: 1px solid rgba(255, 255, 255, .2);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 20px;
      flex-shrink: 0;
    }

    .login-feat-text {
      color: white;
      font-size: 14px;
      font-weight: 600;
    }

    .login-feat-sub {
      color: rgba(255, 255, 255, .6);
      font-size: 12px;
    }

    .login-right {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 40px;
      background: var(--bg);
    }

    .login-card {
      width: 100%;
      max-width: 400px;
      background: white;
      border-radius: 24px;
      padding: 44px 40px;
      box-shadow: 0 20px 60px rgba(0, 0, 0, .12);
    }

    .login-card h2 {
      font-family: 'Bricolage Grotesque';
      font-size: 30px;
      color: var(--text);
      margin-bottom: 4px;
    }

    .login-secure {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: #ecfdf5;
      border: 1px solid #a7f3d0;
      color: #065f46;
      font-size: 11px;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 99px;
      margin-bottom: 16px;
    }

    .login-sub {
      font-size: 14px;
      color: var(--text2);
      margin-bottom: 28px;
    }

    .fg {
      margin-bottom: 18px;
    }

    .fg label {
      display: block;
      font-size: 11px;
      font-weight: 700;
      color: var(--text2);
      margin-bottom: 7px;
      letter-spacing: .06em;
      text-transform: uppercase;
    }

    .fg input {
      width: 100%;
      padding: 12px 14px;
      border: 1.5px solid var(--border2);
      border-radius: 10px;
      font-family: 'Inter';
      font-size: 14px;
      outline: none;
      transition: .15s;
      background: var(--white);
      color: var(--text);
    }

    .fg input:focus {
      border-color: var(--blue);
      box-shadow: 0 0 0 3px rgba(29, 78, 216, .1);
    }

    .pw-wrap {
      position: relative;
    }

    .pw-wrap input {
      padding-right: 44px;
    }

    .pw-toggle {
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      background: none;
      border: none;
      cursor: pointer;
      color: var(--text3);
      font-size: 16px;
    }

    .btn-login {
      width: 100%;
      padding: 14px;
      background: linear-gradient(135deg, #1d4ed8, #4f46e5);
      color: white;
      border: none;
      border-radius: 11px;
      font-family: 'Inter';
      font-size: 15px;
      font-weight: 700;
      cursor: pointer;
      transition: .2s;
      letter-spacing: .01em;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    .btn-login:hover {
      transform: translateY(-1px);
      box-shadow: 0 8px 24px rgba(29, 78, 216, .35);
    }

    .login-hint {
      background: #eff6ff;
      border: 1px solid #bfdbfe;
      border-radius: 9px;
      padding: 12px 14px;
      font-size: 12px;
      color: #1e40af;
      margin-top: 16px;
      text-align: center;
      line-height: 1.6;
    }

    .login-err {
      background: #fef2f2;
      border: 1px solid #fecaca;
      border-radius: 9px;
      padding: 10px 14px;
      font-size: 13px;
      color: var(--red);
      margin-bottom: 14px;
      display: none;
    }

    /* ══ SMALL GROUP TEACHING (SGT) ══ */
    .sgt-container {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 20px;
      padding: 24px;
      overflow-y: auto;
    }

    .sgt-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
      gap: 20px;
    }

    .session-card {
      background: white;
      border-radius: 20px;
      padding: 24px;
      border: 1px solid var(--border);
      transition: .2s;
      display: flex;
      flex-direction: column;
      gap: 16px;
      box-shadow: var(--sh);
    }

    .session-card:hover {
      transform: translateY(-2px);
      box-shadow: var(--sh2);
    }

    .session-icon {
      width: 48px;
      height: 48px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 24px;
    }

    .session-status {
      font-size: 11px;
      font-weight: 700;
      padding: 4px 10px;
      border-radius: 99px;
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    .status-live {
      background: #fef2f2;
      color: #dc2626;
      border: 1px solid #fecaca;
    }

    .status-live::before {
      content: '';
      width: 6px;
      height: 6px;
      background: #dc2626;
      border-radius: 50%;
      animation: pulseSGT 1.5s infinite;
    }

    @keyframes pulseSGT {
      0% {
        opacity: 1;
      }

      50% {
        opacity: .4;
      }

      100% {
        opacity: 1;
      }
    }

    .pin-entry-card {
      max-width: 440px;
      margin: 80px auto;
      background: white;
      border-radius: 24px;
      padding: 40px;
      box-shadow: var(--sh3);
      text-align: center;
    }

    .pin-input-group {
      display: flex;
      gap: 10px;
      justify-content: center;
      margin: 24px 0;
    }

    .pin-box {
      width: 48px;
      height: 56px;
      border: 2px solid var(--border);
      border-radius: 12px;
      font-size: 24px;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      outline: none;
      transition: .2s;
    }

    .pin-box:focus {
      border-color: var(--blue);
      background: var(--blueLight);
    }

    .jitsi-wrap {
      flex: 1;
      background: #0f172a;
      border-radius: 20px;
      overflow: hidden;
      position: relative;
      margin: 24px;
      box-shadow: var(--sh3);
      display: flex;
    }

    .jitsi-placeholder {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      color: white;
      text-align: center;
      gap: 20px;
      background: linear-gradient(135deg, #0f172a, #1e3a8a);
    }

    /* ══ DASHBOARD ══ */
    #screen-dashboard {
      flex-direction: column;
    }

    .dash-body {
      flex: 1;
      overflow: hidden;
      display: grid;
      grid-template-columns: 1fr 340px;
      gap: 24px;
      padding: 20px 24px;
      min-height: 0;
    }

    .dash-left {
      display: flex;
      flex-direction: column;
      gap: 20px;
      min-height: 0;
      overflow: hidden;
    }

    .dash-right {
      display: flex;
      flex-direction: column;
      gap: 16px;
      overflow-y: auto;
      padding-right: 2px;
    }

    /* Welcome card */
    .welcome-card {
      background: linear-gradient(135deg, #0f172a 0%, #1e3a8a 45%, #1d4ed8 100%);
      border-radius: 20px;
      padding: 28px 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-shrink: 0;
      color: white;
      position: relative;
      overflow: hidden;
    }

    .welcome-card::before {
      content: '';
      position: absolute;
      top: -60px;
      right: -60px;
      width: 240px;
      height: 240px;
      background: rgba(99, 179, 237, .08);
      border-radius: 50%;
    }

    .welcome-card::after {
      content: '';
      position: absolute;
      bottom: -40px;
      right: 100px;
      width: 160px;
      height: 160px;
      background: rgba(99, 179, 237, .05);
      border-radius: 50%;
    }

    .welcome-text h2 {
      font-family: 'Bricolage Grotesque';
      font-size: 28px;
      font-weight: 700;
      margin-bottom: 4px;
    }

    .welcome-text p {
      font-size: 14px;
      opacity: .72;
    }

    .welcome-stats {
      display: flex;
      gap: 28px;
      margin-top: 20px;
    }

    .wel-stat {
      display: flex;
      flex-direction: column;
    }

    .wel-stat-val {
      font-family: 'Bricolage Grotesque';
      font-size: 26px;
      font-weight: 700;
      line-height: 1;
    }

    .wel-stat-lbl {
      font-size: 11px;
      opacity: .65;
      margin-top: 4px;
      text-transform: uppercase;
      letter-spacing: .06em;
    }

    .wel-stat-sep {
      width: 1px;
      background: rgba(255, 255, 255, .2);
      margin: 0 4px;
    }

    .year-select {
      background: rgba(255, 255, 255, .14);
      border: 1px solid rgba(255, 255, 255, .22);
      color: white;
      padding: 10px 40px 10px 16px;
      border-radius: 11px;
      font-family: inherit;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      outline: none;
      appearance: none;
      backdrop-filter: blur(8px);
    }

    .year-select option {
      background: #1e3a8a;
      color: white;
    }

    .year-wrap {
      position: relative;
      text-align: right;
    }

    .year-label {
      display: block;
      font-size: 10px;
      font-weight: 700;
      opacity: .75;
      margin-bottom: 8px;
      text-transform: uppercase;
      letter-spacing: .06em;
    }

    /* Subjects */
    .subjects-section {
      flex: 1;
      min-height: 0;
      overflow: hidden;
      display: flex;
      flex-direction: column;
    }

    .section-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 14px;
    }

    .section-label {
      font-family: 'Bricolage Grotesque';
      font-size: 17px;
      font-weight: 700;
      color: var(--text);
    }

    .nmc-badge {
      background: var(--blueLight);
      color: var(--blue);
      font-size: 11px;
      font-weight: 700;
      padding: 5px 12px;
      border-radius: 99px;
      border: 1px solid rgba(30, 58, 138, .12);
    }

    .subjects-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
      gap: 16px;
      overflow-y: auto;
      flex: 1;
      padding-bottom: 8px;
    }

    .subject-card {
      background: white;
      border-radius: 18px;
      padding: 22px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 10px;
      cursor: pointer;
      transition: all .22s;
      border: 1.5px solid transparent;
      box-shadow: var(--sh);
    }

    .subject-card:hover {
      transform: translateY(-5px);
      box-shadow: var(--sh2);
      border-color: rgba(30, 58, 138, .12);
    }

    .subject-icon {
      width: 60px;
      height: 60px;
      border-radius: 16px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 26px;
    }

    .subject-name {
      font-family: 'Bricolage Grotesque';
      font-size: 15px;
      font-weight: 700;
      color: var(--text);
    }

    .subject-code {
      font-size: 12px;
      font-weight: 600;
      color: var(--text3);
    }

    .subject-progress {
      width: 100%;
      height: 5px;
      background: #f1f5f9;
      border-radius: 99px;
      overflow: hidden;
    }

    .subject-prog-bar {
      height: 100%;
      border-radius: 99px;
    }

    /* Right panel */
    .quick-cards {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .quick-card {
      border-radius: 18px;
      overflow: hidden;
      position: relative;
      height: 110px;
      cursor: pointer;
      transition: .22s;
      box-shadow: var(--sh);
    }

    .quick-card:hover {
      transform: translateY(-3px);
      box-shadow: var(--sh2);
    }

    .quick-card img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .quick-card-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(to right, rgba(0, 0, 0, .82), rgba(0, 0, 0, .15));
    }

    .quick-card-content {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: 18px;
    }

    .quick-card-label {
      color: white;
      font-family: 'Bricolage Grotesque';
      font-size: 15px;
      font-weight: 700;
    }

    .quick-card-sub {
      color: rgba(255, 255, 255, .78);
      font-size: 11px;
      margin-top: 3px;
    }

    .q-badge {
      position: absolute;
      top: 10px;
      right: 10px;
      font-size: 10px;
      font-weight: 700;
      padding: 3px 9px;
      border-radius: 99px;
      color: white;
    }

    .progress-card {
      background: white;
      border-radius: 18px;
      padding: 20px;
      flex-shrink: 0;
      box-shadow: var(--sh);
    }

    .progress-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 14px;
    }

    .progress-header h3 {
      font-family: 'Bricolage Grotesque';
      font-size: 15px;
      font-weight: 700;
      color: var(--text);
    }

    .overall-pct {
      font-size: 14px;
      font-weight: 700;
      color: var(--blue);
    }

    .progress-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .prog-item {
      display: flex;
      flex-direction: column;
      gap: 5px;
    }

    .prog-info {
      display: flex;
      justify-content: space-between;
      font-size: 12px;
      font-weight: 600;
      color: var(--text2);
    }

    .prog-bar-wrap {
      width: 100%;
      height: 7px;
      background: #f1f5f9;
      border-radius: 99px;
