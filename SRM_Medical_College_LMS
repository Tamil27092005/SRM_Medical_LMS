    function addTutorMsg(text, from) {
      const msgs = document.getElementById('tutor-msgs');
      const el = document.createElement('div');
      el.className = `tutor-msg ${from}`;
      el.style.whiteSpace = 'pre-line';

      if (from === 'bot') {
        // Strip entire <a> elements first (tag + attributes + content preserved)
        let cleaned = text
          .replace(/<a\b[^>]*>(.*?)<\/a>/gis, '$1')  // keep inner text, strip tag+attrs
          .replace(/style="[^"]*"/g, '')
          .replace(/onmouseover="[^"]*"/g, '')
          .replace(/onmouseout="[^"]*"/g, '')
          .replace(/title="[^"]*"/g, '')
          .replace(/href="[^"]*"/g, '')
          .replace(/target="[^"]*"/g, '')
          .replace(/<(?!strong|\/strong|em|\/em|br)[^>]+>/gi, '');

        el.innerHTML = formatTutorResponse(cleaned);
      } else {
        el.textContent = text;
      }

      msgs.appendChild(el);
      msgs.scrollTop = msgs.scrollHeight;
    }

    function formatTutorResponse(text) {
      if (!text) return '';

      let html = text
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;');

      // Bold
      html = html.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');

      // Italic
      html = html.replace(/\*(.*?)\*/g, '<em style="color:var(--text2);">$1</em>');

      // Headers 【CONCEPT】
      html = html.replace(/【(.*?)】/g,
        '<span style="display:block;margin:14px 0 6px;font-family:\'Bricolage Grotesque\';font-size:15px;font-weight:800;color:var(--blue);border-bottom:2px solid var(--blueLight);padding-bottom:4px;">【$1】</span>');

      // [[REF:term]] → clean "Source ↗" hyperlink (only for key points)
      // [[REF:term]] → Smart "Source ↗" hyperlink with best medical source
      html = html.replace(/\[\[REF:(.*?)\]\]/g, (match, searchTerm) => {
        const term = searchTerm.trim().toLowerCase();
        const encoded = encodeURIComponent(searchTerm.trim());

        // Smart source selector based on term type
        let sourceUrl = '';
        let sourceLabel = 'Source ↗';

        if (
          term.match(/drug|antibiotic|dose|pharmacol|aspirin|penicillin|amoxicillin|metformin|insulin|warfarin|statin|inhibitor|agonist|antagonist/)
        ) {
          // Drug → Drugs.com
          sourceUrl = `https://www.drugs.com/search.php?searchterm=${encoded}`;
          sourceLabel = 'Drug Info ↗';

        } else if (
          term.match(/syndrome|disease|disorder|failure|cancer|carcinoma|tumour|tumor|infarction|itis|osis|emia|pathy|plasia/)
        ) {
          // Disease/Condition → MedlinePlus
          sourceUrl = `https://www.mayoclinic.org/search/search-results?q=${encoded}`;
          sourceLabel = 'Mayo Clinic ↗';

        } else if (
          term.match(/anatomy|bone|muscle|nerve|artery|vein|organ|joint|ligament|tendon|fascia|cortex|nucleus|lobe/)
        ) {
          // Anatomy → Kenhub
          sourceUrl = `https://www.kenhub.com/en/search?q=${encoded}`;
          sourceLabel = 'Anatomy ↗';

        } else if (
          term.match(/guideline|protocol|management|criteria|staging|classification|score|treatment|therapy|indication/)
        ) {
          // Clinical guidelines → WHO / UpToDate search
          sourceUrl = `https://www.who.int/search?query=${encoded}`;
          sourceLabel = 'WHO ↗';

        } else if (
          term.match(/physiology|mechanism|pathway|receptor|signal|hormone|enzyme|transport|membrane|potential|cycle/)
        ) {
          // Physiology/Biochem → Khan Academy Med
          sourceUrl = `https://www.khanacademy.org/search?page_search_query=${encoded}`;
          sourceLabel = 'Learn ↗';

        } else {
          // Default fallback → PubMed (research)
          sourceUrl = `https://pubmed.ncbi.nlm.nih.gov/?term=${encoded}`;
          sourceLabel = 'PubMed ↗';
        }

        return `<a href="${sourceUrl}" target="_blank" title="📚 Read more: ${searchTerm.trim()}" style="color:var(--blue2);font-size:11px;font-weight:600;text-decoration:underline;margin-left:3px;display:inline-flex;align-items:center;gap:2px;vertical-align:middle;cursor:pointer;transition:opacity .15s;" onmouseover="this.style.opacity='.7'" onmouseout="this.style.opacity='1'">${sourceLabel}</a>`;
      });

      // Bullet points
      html = html.replace(/^[-•]\s+(.+)/gm,
        '<div style="margin:4px 0 4px 16px;display:flex;gap:8px;"><span style="color:var(--text3);flex-shrink:0;">–</span><span>$1</span></div>');

      // Line breaks
      html = html.replace(/\n/g, '<br>');

      return html;
    }

