    const CHAPTERS_DATA = [
      { title: 'Introduction & Overview', time: '0:00', threshold: 0, locked: false },
      { title: 'Core Concepts', time: '5:30', threshold: 20, locked: false },
      { title: 'Clinical Relevance', time: '12:00', threshold: 45, locked: true },
      { title: 'Case Discussion', time: '20:00', threshold: 70, locked: true },
      { title: 'Summary & Key Points', time: '25:30', threshold: 90, locked: true }
