      <!-- Refine Chat -->
      <div class="res-refine-chat">
        <div style="padding:10px 14px;background:linear-gradient(135deg,#0f172a,#1d4ed8);color:white;display:flex;align-items:center;gap:8px;">
          <span style="font-size:14px;">🤖</span>
          <div>
            <div style="font-size:13px;font-weight:700;">Refine Assistant</div>
            <div style="font-size:10px;opacity:.7;">Ask AI to improve any section</div>
          </div>
        </div>
        <div class="res-refine-msgs" id="res-refine-msgs">
          <div class="res-refine-msg bot">I've built your methodology framework. Ask me to refine any section — e.g. "Make the objectives more specific" or "Add 2 more exclusion criteria"</div>
        </div>
        <div class="res-refine-input-row">
          <input class="res-refine-input" id="res-refine-input" placeholder="e.g. Make objectives more SMART..." onkeydown="if(event.key==='Enter')sendResRefine()" />
          <button class="btn-chat-send" onclick="sendResRefine()">→</button>
        </div>
      </div>

      <div style="display:flex;gap:10px;margin-top:20px;">
        <button class="btn-sec" onclick="renderResStep3()">← Back</button>
        <button class="btn-prim" style="flex:1;" onclick="renderResStep5()">Finalize & Export →</button>
      </div>
    </div>
  `;
    }

    function toggleResSection(i) {
      const content = document.getElementById('rsec-content-' + i);
      const arrow = document.getElementById('rsec-arrow-' + i);
      if (!content) return;
      const isHidden = content.style.display === 'none';
      content.style.display = isHidden ? 'block' : 'none';
      if (arrow) arrow.textContent = isHidden ? '▼' : '▶';
    }

    async function sendResRefine() {
      const inp = document.getElementById('res-refine-input');
      const text = inp.value.trim();
      if (!text) return;
      inp.value = '';
      addResRefineMsg(text, 'user');
      resState.refineHistory.push({ role: 'user', content: text });

      // Collect current text from all section textareas
      const currentMethodology = {};
      const sectionKeys = ['aim', 'objectives', 'studyPopulation', 'studySetting', 'inclusionCriteria', 'exclusionCriteria', 'sampleSizeGuidance', 'dataCollectionTool', 'variables', 'statisticalApproach', 'ethicsChecklist', 'literatureGap'];
      for (let i = 0; i < 12; i++) {
        const el = document.getElementById('rsec-text-' + i);
        if (el) currentMethodology[sectionKeys[i]] = el.value;
      }

      try {
        const prompt = `You are a research mentor. The student is asking you to refine their methodology.
Current methodology summary: ${JSON.stringify(currentMethodology)}
Student's request: "${text}"

Respond conversationally in 2-3 sentences. If you're suggesting a change, provide the improved text directly.`;

        const msgs = resState.refineHistory.map(m => ({ role: m.role, content: m.content }));
        const reply = await callResearchAI(msgs, prompt, false);
        resState.refineHistory.push({ role: 'assistant', content: reply });
        addResRefineMsg(reply, 'bot');
      } catch (e) {
        addResRefineMsg('Connection error. Please try again.', 'bot');
      }
    }

    function addResRefineMsg(text, from) {
      const msgs = document.getElementById('res-refine-msgs');
      if (!msgs) return;
      const el = document.createElement('div');
      el.className = 'res-refine-msg ' + from;
      el.textContent = text;
      msgs.appendChild(el);
      msgs.scrollTop = msgs.scrollHeight;
    }

    // ── STEP 5: Export ──
    function renderResStep5() {
      updateResStepUI(5);
      const m = resState.methodology;
      const design = resState.designs?.designs[resState.selectedDesign];

      document.getElementById('research-body').innerHTML = `
    <div class="res-card" style="text-align:center;">
      <div style="font-size:56px;margin-bottom:12px;">🎉</div>
      <h2 style="margin-bottom:8px;">Research Framework Complete!</h2>
      <p>Your structured UG research proposal is ready. Save or export it below.</p>

      <div style="background:var(--greenLight);border:1px solid #a7f3d0;border-radius:14px;padding:20px;margin:20px 0;text-align:left;">
        <div style="font-size:11px;font-weight:700;color:#065f46;text-transform:uppercase;margin-bottom:8px;">Research Summary</div>
        <div style="font-size:15px;font-weight:700;color:var(--text);margin-bottom:8px;font-family:'Bricolage Grotesque';">${resState.title}</div>
        <div style="display:flex;gap:10px;flex-wrap:wrap;">
          <span style="background:white;border:1px solid #a7f3d0;color:#065f46;font-size:11px;font-weight:600;padding:3px 10px;border-radius:99px;">📐 ${design?.name || 'Study'}</span>
          <span style="background:white;border:1px solid #a7f3d0;color:#065f46;font-size:11px;font-weight:600;padding:3px 10px;border-radius:99px;">🏥 ${resState.dept || 'General Medicine'}</span>
          <span style="background:white;border:1px solid #a7f3d0;color:#065f46;font-size:11px;font-weight:600;padding:3px 10px;border-radius:99px;">📋 ${m ? Object.keys(m).length : 0} Sections Complete</span>
        </div>
      </div>

      <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-bottom:20px;">
        <button class="res-export-btn" style="background:linear-gradient(135deg,#1d4ed8,#4f46e5);color:white;" onclick="resCopyToClipboard()">
          📋 Copy to Clipboard
        </button>
        <button class="res-export-btn" style="background:linear-gradient(135deg,#059669,#10b981);color:white;" onclick="resPrintProposal()">
          🖨️ Print / Save as PDF
        </button>
      </div>

      <div style="text-align:left;background:#f8fafc;border:1px solid var(--border);border-radius:14px;padding:20px;" id="res-print-area">
        <div style="font-family:'Bricolage Grotesque';font-size:20px;font-weight:800;margin-bottom:4px;">${resState.title}</div>
        <div style="font-size:12px;color:var(--text2);margin-bottom:16px;">Study Design: ${design?.name} &bull; Department: ${resState.dept || 'General'} &bull; SRM Medical College</div>
        ${m ? `
          <div style="margin-bottom:12px;"><strong>Aim:</strong><br>${m.aim}</div>
          <div style="margin-bottom:12px;"><strong>Objectives:</strong><br>${Array.isArray(m.objectives) ? m.objectives.map((o, i) => `${i + 1}. ${o}`).join('<br>') : m.objectives}</div>
          <div style="margin-bottom:12px;"><strong>Study Population:</strong><br>${m.studyPopulation}</div>
          <div style="margin-bottom:12px;"><strong>Inclusion Criteria:</strong><br>${Array.isArray(m.inclusionCriteria) ? m.inclusionCriteria.map((c, i) => `${i + 1}. ${c}`).join('<br>') : m.inclusionCriteria}</div>
          <div style="margin-bottom:12px;"><strong>Exclusion Criteria:</strong><br>${Array.isArray(m.exclusionCriteria) ? m.exclusionCriteria.map((c, i) => `${i + 1}. ${c}`).join('<br>') : m.exclusionCriteria}</div>
          <div style="margin-bottom:12px;"><strong>Sample Size:</strong><br>${m.sampleSizeGuidance}</div>
          <div style="margin-bottom:12px;"><strong>Data Collection:</strong><br>${m.dataCollectionTool}</div>
          <div style="margin-bottom:12px;"><strong>Statistical Approach:</strong><br>${m.statisticalApproach}</div>
          <div style="margin-bottom:12px;"><strong>Ethics Checklist:</strong><br>${Array.isArray(m.ethicsChecklist) ? m.ethicsChecklist.map(e => `☐ ${e}`).join('<br>') : m.ethicsChecklist}</div>
          <div><strong>Research Gap:</strong><br>${m.literatureGap}</div>
        ` : ''}
      </div>

      <div style="margin-top:16px;">
        <button class="btn-sec" onclick="initResearch()">🔄 Start New Research</button>
      </div>
    </div>
  `;
    }

    function resCopyToClipboard() {
      const area = document.getElementById('res-print-area');
      if (!area) return;
      const text = area.innerText;
      navigator.clipboard.writeText(text).then(() => {
        alert('✅ Research proposal copied to clipboard!');
      }).catch(() => {
        alert('Copy failed. Please manually select and copy the text.');
      });
    }

    function resPrintProposal() {
      const area = document.getElementById('res-print-area');
      if (!area) return;
      const win = window.open('', '_blank');
      win.document.write(`<html><head><title>Research Proposal — ${resState.title}</title>
    <style>body{font-family:Arial,sans-serif;padding:40px;max-width:800px;margin:0 auto;line-height:1.6;}
    strong{display:block;margin-top:14px;color:#1e3a8a;}
    </style></head><body>${area.innerHTML}</body></html>`);
      win.document.close();
      win.print();
    }



    // ══════════════════════════════════════════════
    //  INIT
    // ══════════════════════════════════════════════
    renderDashboard(1);

    // Silent Startup Connectivity Check
    async function bootAIHealth() {
      try {
        console.log("Checking AI connectivity...");
        await callGroqAI([{ role: 'user', content: 'ping' }], 'general', 'respond only with pong');
        console.log("AI is ready.");
      } catch (e) {
        console.warn("AI initial check failed, waiting for user action.");
      }
    }
    bootAIHealth();
  </script>
</body>

</html>
