      document.getElementById('comp-list').innerHTML = filtered.map(c => {
        const isDone = state.completed.has(c.id);
        const ls = LEVEL_STYLES[c.level];
        return `<div class="comp-item ${isDone ? 'done' : ''}" onclick="openCompetency('${c.id}')">
