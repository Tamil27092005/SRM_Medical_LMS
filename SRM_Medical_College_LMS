    function speakText(text, gender = 'female', forceLang = null, retryCount = 0) {
      if (!VOICE.active) return;

      // STOP all ongoing audio
      window.speechSynthesis.cancel();
      if (VOICE.activeAudio) {
        VOICE.activeAudio.pause();
        VOICE.activeAudio = null;
      }

      // If voices haven't loaded yet, retry (for local fallback)
      if (VOICE.voices.length === 0 && retryCount < 5) {
        setTimeout(() => speakText(text, gender, forceLang, retryCount + 1), 500);
      }

      const cleanText = text.replace(/\*(.*?)\*/g, '').replace(/\[\[.*?\]\]/g, '').trim();

      // Determine language mapping for Sarvam
      // Determine language mapping for Sarvam (Supports 11 Indic languages)
      const langMap = {
        'English': 'en-IN', 'Hindi': 'hi-IN', 'Tamil': 'ta-IN', 'Telugu': 'te-IN',
        'Bengali': 'bn-IN', 'Marathi': 'mr-IN', 'Kannada': 'kn-IN', 'Malayalam': 'ml-IN',
        'Gujarati': 'gu-IN', 'Punjabi': 'pa-IN', 'Odia': 'or-IN'
      };
      const targetLang = forceLang || langMap[state.clinLang] || 'en-IN';

      // 1. PRIMARY: Try Sarvam.ai for high-fidelity regional speech
      if (targetLang !== 'en-IN' || state.clinLang === 'English') {
        const currentKey = AI_CONFIG.sarvam_keys[sarvamKeyIdx].val;
        callSarvamTTS(cleanText, targetLang, gender, currentKey).then(res => {
          if (res) return; // Success!
          // Rotate key on failure
          sarvamKeyIdx = (sarvamKeyIdx + 1) % AI_CONFIG.sarvam_keys.length;
          proceedToLocalSpeech(cleanText, targetLang, gender);
        });
      } else {
        proceedToLocalSpeech(cleanText, targetLang, gender);
      }
    }

    /**
     * Sarvam AI Text Generation (turns system)
     */
    async function callSarvamAI(messages, systemMsg = "") {
      const key = AI_CONFIG.sarvam_keys[sarvamKeyIdx].val;
      console.log(`[AI] Using Sarvam turn (${AI_CONFIG.sarvam_keys[sarvamKeyIdx].id})...`);

      try {
        const response = await fetch("https://api.sarvam.ai/v1/chat/completions", {
          method: "POST",
          headers: {
            "api-subscription-key": key,
            "Content-Type": "application/json"
          },
          body: JSON.stringify({
            model: "sarvam-2-plus",
            messages: systemMsg ? [{ role: "system", content: systemMsg }, ...messages] : messages,
            temperature: 0.7,
          })
        });

        if (!response.ok) throw new Error(`Sarvam Text API Error: ${response.status}`);
        const data = await response.json();
        return data.choices[0].message.content;
      } catch (err) {
        console.error("Sarvam Text Failed, falling back to Groq:", err);
        // Rotate key for next time
        sarvamKeyIdx = (sarvamKeyIdx + 1) % AI_CONFIG.sarvam_keys.length;
        throw err;
      }
    }

    /**
     * Universal AI Wrapper (The Toggle/Turns System)
     */
    async function callUniversalAI(messages, type, systemMsg, isJson) {
      // Toggle provider for every request
      const useSarvam = AI_CONFIG.provider_turn === 1;
      AI_CONFIG.provider_turn = (AI_CONFIG.provider_turn + 1) % 2; // Flip for next turn

      if (useSarvam) {
        try { return await callSarvamAI(messages, systemMsg); }
        catch (e) { return await callGroqAI(messages, type, systemMsg, isJson); }
      } else {
        try { return await callGroqAI(messages, type, systemMsg, isJson); }
        catch (e) { return await callSarvamAI(messages, systemMsg); }
      }
    }

    async function callSarvamTTS(text, lang, gender, key) {
      if (!key || text.length < 2) return false;
      try {
        console.log(`SRM Voice: Calling Sarvam AI for ${lang}...`);
        const response = await fetch("https://api.sarvam.ai/text-to-speech", {
          method: "POST",
          headers: {
            "api-subscription-key": key,
            "Content-Type": "application/json"
          },
          body: JSON.stringify({
            text: text,
            target_language_code: lang,
            speaker: gender === 'female' ? 'kavya' : 'amit',
            model: "bulbul:v3"
          })
        });

        if (!response.ok) {
          const err = await response.text();
          console.error("Sarvam API Error:", response.status, err);
          return false;
        }

        const data = await response.json();
        if (data.audios && data.audios[0]) {
          const audioData = data.audios[0];
          VOICE.activeAudio = new Audio(`data:audio/wav;base64,${audioData}`);
          VOICE.activeAudio.play();
          return true;
        }
      } catch (e) {
        console.error("Sarvam Connection Error (Check CORS):", e);
      }
      return false;
    }

    function proceedToLocalSpeech(cleanText, targetLang, gender) {
      const u = new SpeechSynthesisUtterance(cleanText);
      // High-fidelity local voice search keywords
      const femaleKeywords = ['female', 'aura', 'zira', 'heera', 'sangeeta', 'kalpana', 'susan', 'hazel', 'linda', 'catherine'];
      const maleKeywords = ['male', 'david', 'ravi', 'valluvar', 'mark', 'george', 'james', 'richard'];

      let v = VOICE.voices.find(v => {
        const n = v.name.toLowerCase();
        const isLang = v.lang.toLowerCase().includes(targetLang.toLowerCase()) || (targetLang.startsWith('en') && v.lang.includes('en'));
        const isG = gender === 'female' ? femaleKeywords.some(k => n.includes(k)) : maleKeywords.some(k => n.includes(k));
        return isLang && isG;
      });

      if (!v) v = VOICE.voices.find(v => {
        const n = v.name.toLowerCase();
        return gender === 'female' ? femaleKeywords.some(k => n.includes(k)) : maleKeywords.some(k => n.includes(k));
      });

      if (!v) v = VOICE.voices.find(v => v.lang.toLowerCase().includes(targetLang.split('-')[0].toLowerCase()));

      // Fallback to English Mirror if no native voice found locally
      const hasNativeVoice = v && v.lang.toLowerCase().includes(targetLang.split('-')[0].toLowerCase());
      if (!hasNativeVoice && state.clinLang !== 'English') {
        console.log("SRM Voice: Local native missing. Falling back to English Mirror.");
        const mirrorMatch = document.getElementById('clinical-msgs').lastElementChild?.innerText.match(/\[\[(.*?)\]\]/);
        if (mirrorMatch) {
          speakText(mirrorMatch[1], gender, 'en-IN');
          return;
        }
      }

      if (v) u.voice = v;
      u.lang = v ? v.lang : 'en-US';
      u.pitch = gender === 'female' ? 1.05 : 0.95;
      u.rate = 1.0;
      window.speechSynthesis.speak(u);
    }

    async function startWhisper(inputId) {
      if (VOICE.isListening) { stopWhisper(); return; }

      try {
        const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
        VOICE.recorder = new MediaRecorder(stream);
        VOICE.chunks = [];
        VOICE.targetInput = inputId;
        VOICE.isListening = true;

        document.querySelectorAll('.mic-btn').forEach(b => b.classList.add('active'));
        const badge = document.getElementById('tutor-listening-badge');
        if (badge) badge.style.display = 'block';

        VOICE.recorder.ondataavailable = e => VOICE.chunks.push(e.data);
        VOICE.recorder.onstop = async () => {
          const blob = new Blob(VOICE.chunks, { type: 'audio/webm' });
          processAudioWithWhisper(blob);
        };

        // REPLACE WITH:
        VOICE.recorder.start(250); // collect chunks every 250ms

        // Auto-stop after 45 seconds max (safety limit)
        VOICE.autoStopTimer = setTimeout(() => {
          if (VOICE.isListening) stopWhisper();
        }, 45000);

        // Silence detection — stops 2.5 seconds after voice goes quiet
        const audioCtx = new AudioContext();
        const source = audioCtx.createMediaStreamSource(stream);
        const analyser = audioCtx.createAnalyser();
        analyser.fftSize = 512;
        source.connect(analyser);
        const dataArr = new Uint8Array(analyser.frequencyBinCount);
        let silenceStart = null;
        const SILENCE_THRESHOLD = 8;   // volume level below this = silence
        const SILENCE_DURATION = 2500; // 2.5 sec of silence before stopping

        VOICE.silenceChecker = setInterval(() => {
          if (!VOICE.isListening) {
            clearInterval(VOICE.silenceChecker);
            audioCtx.close();
            return;
          }
          analyser.getByteFrequencyData(dataArr);
          const avg = dataArr.reduce((a, b) => a + b, 0) / dataArr.length;

          if (avg < SILENCE_THRESHOLD) {
            if (!silenceStart) silenceStart = Date.now();
            else if (Date.now() - silenceStart > SILENCE_DURATION) {
              clearInterval(VOICE.silenceChecker);
              audioCtx.close();
              stopWhisper();
            }
          } else {
            silenceStart = null; // voice detected — reset silence timer
          }
        }, 200);

      } catch (err) {
        console.error("Mic access failed:", err);
        alert("Microphone access denied or not supported.");
      }
    }

    function stopWhisper() {
      if (!VOICE.isListening) return;
      VOICE.isListening = false;
      document.querySelectorAll('.mic-btn').forEach(b => b.classList.remove('active'));
      const badge = document.getElementById('tutor-listening-badge');
      if (badge) badge.style.display = 'none';
      // Clear timers
      if (VOICE.autoStopTimer) { clearTimeout(VOICE.autoStopTimer); VOICE.autoStopTimer = null; }
      if (VOICE.silenceChecker) { clearInterval(VOICE.silenceChecker); VOICE.silenceChecker = null; }
      if (VOICE.recorder && VOICE.recorder.state !== 'inactive') VOICE.recorder.stop();
      VOICE.recorder.stream.getTracks().forEach(t => t.stop());
    }

    async function processAudioWithWhisper(blob) {
      const inp = document.getElementById(VOICE.targetInput);
      if (!inp) return;

      const oldVal = inp.value;
      inp.value = "Listening...";

      try {
        const formData = new FormData();
        formData.append("file", blob, "audio.webm");
        formData.append("model", "whisper-large-v3");

        // Add language hint to prevent accidental Tamil/Hindi detection when English is expected
        const langMap = { 'English': 'en', 'Hindi': 'hi', 'Tamil': 'ta', 'Telugu': 'te' };
        if (langMap[state.clinLang]) formData.append("language", langMap[state.clinLang]);

        // We use the direct API approach similar to callGroqAI
        const key = AI_CONFIG.keys[currentKeyIdx].val;
        const response = await fetch("https://api.groq.com/openai/v1/audio/transcriptions", {
          method: "POST",
          headers: { "Authorization": `Bearer ${key}` },
          body: formData
        });

        if (!response.ok) throw new Error("Whisper Error " + response.status);

        const data = await response.json();
        inp.value = data.text;

        // Trigger send if it was for chat
        if (VOICE.targetInput === 'clinical-input') sendClinical();
        else if (VOICE.targetInput === 'docbot-input') sendDocbot();
        else if (VOICE.targetInput === 'tutor-input') sendTutor();

