    function renderCompList() {
      const subj = state.currentSubject;
      if (!subj) return;
      const search = document.getElementById('comp-search').value.toLowerCase();
      const LEVEL_STYLES = { 'Must Know': { bg: '#eff6ff', color: '#1d4ed8', border: '#bfdbfe' }, 'Desirable': { bg: '#ecfdf5', color: '#065f46', border: '#a7f3d0' }, 'Nice to Know': { bg: '#fff7ed', color: '#9a3412', border: '#fed7aa' } };
      const filtered = subj.competencies.filter(c => {
        const ms = !search || c.code.toLowerCase().includes(search) || c.title.toLowerCase().includes(search) || c.domain.toLowerCase().includes(search);
        return ms && (state.filterLevel === 'All' || c.level === state.filterLevel);
