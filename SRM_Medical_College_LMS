    // ══════════════════════════════════════════════
    //  RESEARCH DEDICATED AI CALLER (Key Rotation)
    // ══════════════════════════════════════════════
    async function callResearchAI(messages, systemMsg = "", isJson = false) {
      const pool = AI_CONFIG.research_keys;
      const targetUrl = "https://api.groq.com/openai/v1/chat/completions";

      // Try each key in the pool
      for (let attempt = 0; attempt < pool.length; attempt++) {
        const keyObj = pool[AI_CONFIG.research_key_idx];

        // Skip keys that are already known to be rate-limited
        if (keyObj.limited) {
          console.warn(`[Research AI] ${keyObj.id} is rate-limited, skipping...`);
          AI_CONFIG.research_key_idx = (AI_CONFIG.research_key_idx + 1) % pool.length;
          continue;
        }

        try {
          console.log(`[Research AI] Using ${keyObj.id}...`);

          const response = await fetch(targetUrl, {
            method: "POST",
            headers: {
              "Authorization": `Bearer ${keyObj.val}`,
              "Content-Type": "application/json"
            },
            body: JSON.stringify({
              model: "llama-3.3-70b-versatile",
              messages: systemMsg
                ? [{ role: "system", content: systemMsg }, ...messages]
                : messages,
              temperature: 0.7,
              max_tokens: 2000,
              stream: false,
              ...(isJson && { response_format: { type: "json_object" } })
            })
          });

          // Rate limited → rotate to next key
          if (response.status === 429) {
            console.warn(`[Research AI] ${keyObj.id} hit rate limit. Rotating...`);
            keyObj.limited = true;
            keyObj.errors++;
            AI_CONFIG.research_key_idx = (AI_CONFIG.research_key_idx + 1) % pool.length;
            continue; // Try next key immediately
          }

          // Other HTTP errors
          if (!response.ok) {
            const errData = await response.json().catch(() => ({}));
            throw new Error(errData.error?.message || `API Error ${response.status}`);
          }

          const data = await response.json();
          if (!data.choices?.[0]) throw new Error("Empty response from Research AI");

          // Success — reset error state for this key
          keyObj.errors = 0;
          keyObj.limited = false;
          console.log(`[Research AI] Success with ${keyObj.id}`);
          return data.choices[0].message.content;

        } catch (err) {
          console.error(`[Research AI] ${keyObj.id} failed:`, err.message);
          keyObj.errors++;

          // Hard API error (wrong key, bad request) — don't retry with same key
          if (err.message.includes("API Error") || err.message.includes("401")) {
            AI_CONFIG.research_key_idx = (AI_CONFIG.research_key_idx + 1) % pool.length;
          }

          // If it's the last key, throw
          if (attempt === pool.length - 1) {
            throw new Error(`All Research AI keys exhausted. Last error: ${err.message}`);
          }

          // Rotate and retry
          AI_CONFIG.research_key_idx = (AI_CONFIG.research_key_idx + 1) % pool.length;
        }
      }

      throw new Error("All Research API keys are currently rate-limited. Please try again in a minute.");
