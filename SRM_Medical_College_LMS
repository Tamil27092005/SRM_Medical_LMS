      border-radius: 18px;
      padding: 32px 28px 24px;
      width: 360px;
      box-shadow: 0 24px 60px rgba(0, 0, 0, .22);
      text-align: center;
      animation: popIn .22s cubic-bezier(.34, 1.56, .64, 1);
    }

    @keyframes popIn {
      from {
        transform: scale(.85);
        opacity: 0;
      }

      to {
        transform: scale(1);
        opacity: 1;
      }
    }

    .try-again-icon {
      font-size: 46px;
      margin-bottom: 10px;
    }

    .try-again-box h3 {
      font-family: 'Bricolage Grotesque';
      font-size: 20px;
      font-weight: 800;
      color: #0f172a;
      margin-bottom: 8px;
    }

    .try-again-box p {
      font-size: 13px;
      color: #475569;
      line-height: 1.6;
      margin-bottom: 20px;
    }

    .try-again-actions {
      display: flex;
      gap: 10px;
      justify-content: center;
    }

    .try-again-actions .btn-retry {
      background: linear-gradient(135deg, #f59e0b, #d97706);
      color: #fff;
      border: none;
      padding: 10px 22px;
      border-radius: 10px;
      font-size: 13px;
      font-weight: 700;
      cursor: pointer;
      transition: .15s;
    }

    .try-again-actions .btn-retry:hover {
      opacity: .88;
    }

    .try-again-actions .btn-proceed {
      background: #f1f5f9;
      color: #475569;
      border: 1px solid #e2e8f0;
      padding: 10px 18px;
      border-radius: 10px;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      transition: .15s;
    }

    .try-again-actions .btn-proceed:hover {
      background: #e2e8f0;
    }

    /* Notification dot animation */
    @keyframes notifPulse {

      0%,
      100% {
        transform: scale(1);
      }

      50% {
        transform: scale(1.2);
      }
    }

    .nav-bell-badge {
      animation: notifPulse 2s infinite;
    }

    /* ══ UG RESEARCH ASSISTANT ══ */
    .res-step-pill {
      display: flex;
      align-items: center;
      gap: 7px;
      padding: 14px 10px;
      cursor: pointer;
      opacity: .45;
      transition: .2s;
      white-space: nowrap;
    }

    .res-step-pill.active {
      opacity: 1;
    }

    .res-step-pill.done {
      opacity: .85;
    }

    .res-step-num {
      width: 26px;
      height: 26px;
      border-radius: 50%;
      background: #e2e8f0;
      color: var(--text2);
      font-size: 12px;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
      transition: .2s;
    }

    .res-step-pill.active .res-step-num {
      background: var(--blue);
      color: white;
    }

    .res-step-pill.done .res-step-num {
      background: #10b981;
      color: white;
    }

    .res-step-lbl {
      font-size: 12px;
      font-weight: 600;
      color: var(--text2);
    }

    .res-step-pill.active .res-step-lbl {
      color: var(--blue);
      font-weight: 700;
    }

    .res-step-line {
      flex: 1;
      height: 2px;
      background: #e2e8f0;
      min-width: 20px;
      transition: .3s;
    }

    .res-step-line.done {
      background: #10b981;
    }

    .res-card {
      background: white;
      border-radius: 20px;
      padding: 28px 32px;
      box-shadow: var(--sh);
      width: 100%;
      max-width: 820px;
    }

    .res-card h2 {
      font-family: 'Bricolage Grotesque';
      font-size: 22px;
      font-weight: 800;
      margin-bottom: 6px;
    }

    .res-card p {
      font-size: 13px;
      color: var(--text2);
      margin-bottom: 20px;
      line-height: 1.6;
    }

    .res-topic-input {
      width: 100%;
      padding: 12px 14px;
      border: 1.5px solid var(--border2);
      border-radius: 10px;
      font-family: 'Inter';
      font-size: 14px;
      outline: none;
      transition: .15s;
      margin-bottom: 10px;
    }

    .res-topic-input:focus {
      border-color: var(--blue);
      box-shadow: 0 0 0 3px rgba(29, 78, 216, .09);
    }

    .res-topic-row {
      display: flex;
      gap: 8px;
      align-items: center;
      margin-bottom: 10px;
    }

    .res-topic-num {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: var(--blueLight);
      color: var(--blue);
      font-size: 12px;
      font-weight: 800;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .res-remove-btn {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: #fef2f2;
      border: none;
      color: #dc2626;
      cursor: pointer;
      font-size: 14px;
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .res-add-btn {
      display: flex;
      align-items: center;
      gap: 7px;
      background: var(--blueLight);
      color: var(--blue);
      border: 1.5px dashed #93c5fd;
      border-radius: 10px;
      padding: 10px 16px;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      transition: .15s;
      margin-top: 4px;
    }

    .res-add-btn:hover {
      background: #dbeafe;
    }

    .res-topic-card {
      border: 1.5px solid var(--border);
      border-radius: 14px;
      padding: 18px 20px;
      margin-bottom: 12px;
      transition: .2s;
      cursor: pointer;
      position: relative;
    }

    .res-topic-card:hover {
      border-color: #93c5fd;
      box-shadow: 0 4px 12px rgba(29, 78, 216, .08);
    }

    .res-topic-card.selected {
      border-color: var(--blue);
      background: #f0f7ff;
    }

    .res-topic-card.recommended {
      border-color: #10b981;
      background: #f0fdf4;
    }

    .res-feas-bar {
      height: 5px;
      border-radius: 99px;
      background: #e2e8f0;
      overflow: hidden;
      margin-top: 8px;
    }

    .res-feas-fill {
      height: 100%;
      border-radius: 99px;
    }

    .res-design-card {
      border: 2px solid var(--border);
      border-radius: 16px;
      padding: 20px 22px;
      margin-bottom: 12px;
      cursor: pointer;
      transition: .2s;
      display: flex;
      gap: 16px;
      align-items: flex-start;
    }

    .res-design-card:hover {
      border-color: #93c5fd;
      box-shadow: 0 4px 12px rgba(29, 78, 216, .08);
    }

    .res-design-card.selected {
      border-color: var(--blue);
      background: #f0f7ff;
    }

    .res-design-icon {
      width: 44px;
      height: 44px;
      border-radius: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 22px;
      flex-shrink: 0;
    }

    .res-meth-section {
      border: 1.5px solid var(--border);
      border-radius: 12px;
      margin-bottom: 12px;
      overflow: hidden;
    }

    .res-meth-header {
      padding: 12px 16px;
      background: #f8fafc;
      display: flex;
      align-items: center;
      justify-content: space-between;
      cursor: pointer;
    }

    .res-meth-header h4 {
      font-size: 13px;
      font-weight: 700;
      color: var(--text);
    }

    .res-meth-content {
      padding: 14px 16px;
      font-size: 13px;
      color: var(--text2);
      line-height: 1.7;
      border-top: 1px solid var(--border);
      white-space: pre-line;
    }

    .res-refine-chat {
      border: 1.5px solid var(--border);
      border-radius: 14px;
      overflow: hidden;
      margin-top: 16px;
    }

    .res-refine-msgs {
      max-height: 200px;
      overflow-y: auto;
      padding: 12px 16px;
      display: flex;
      flex-direction: column;
      gap: 8px;
      background: #f8fafc;
    }

    .res-refine-msg {
      max-width: 88%;
      padding: 8px 12px;
      border-radius: 10px;
      font-size: 13px;
      line-height: 1.5;
    }

    .res-refine-msg.user {
      align-self: flex-end;
      background: var(--blue);
      color: white;
      border-bottom-right-radius: 3px;
    }

    .res-refine-msg.bot {
      align-self: flex-start;
      background: white;
      border: 1px solid var(--border);
      border-bottom-left-radius: 3px;
    }

    .res-refine-input-row {
      display: flex;
      gap: 8px;
      padding: 10px 12px;
      border-top: 1px solid var(--border);
      background: white;
    }

    .res-refine-input {
      flex: 1;
      padding: 8px 12px;
      border: 1.5px solid var(--border2);
      border-radius: 9px;
      font-family: 'Inter';
      font-size: 13px;
      outline: none;
    }

    .res-refine-input:focus {
      border-color: var(--blue);
    }

    .res-export-btn {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 12px 22px;
      border-radius: 11px;
      font-family: 'Inter';
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
      transition: .2s;
      border: none;
    }

    .res-export-btn:hover {
      transform: translateY(-2px);
      box-shadow: var(--sh2);
    }

    /* ══ MOBILE RESPONSIVENESS ══ */
    @media (max-width: 992px) {
      .dash-body {
        grid-template-columns: 1fr;
        overflow-y: auto;
      }

      .dash-right {
        overflow-y: visible;
        padding-right: 0;
      }

      .welcome-card {
        padding: 24px;
      }

      .welcome-text h2 {
        font-size: 24px;
      }

      .welcome-stats {
        gap: 16px;
      }
    }

    /* 🎤 VOICE UI 🎤 */
    .voice-ctrl {
      display: flex;
      align-items: center;
      gap: 8px;
      background: var(--white);
      padding: 8px 12px;
      border-radius: var(--r);
      border: 1.5px solid var(--border);
      box-shadow: var(--sh);
      margin-top: 10px;
      cursor: pointer;
      transition: .2s;
    }

    .voice-ctrl:hover {
      border-color: var(--blue2);
      transform: translateY(-1px);
    }

    .voice-ctrl.active {
      border-color: var(--greenMid);
      background: var(--greenLight);
    }

    .voice-ctrl.active .v-dot {
      background: var(--greenMid);
      box-shadow: 0 0 8px var(--greenMid);
      animation: pulse 1s infinite;
    }

    .v-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #94a3b8;
      transition: .2s;
    }

    .v-lbl {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .05em;
      color: var(--text);
    }

    .mic-btn {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      background: var(--blueLight);
      border: 1px solid #bfdbfe;
      color: var(--blue2);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      transition: .2s;
      flex-shrink: 0;
      position: relative;
    }

    .mic-btn:hover {
      background: #dbeafe;
      transform: scale(1.05);
    }

    .mic-btn.active {
      background: #fee2e2;
      border-color: #fecaca;
      color: #dc2626;
    }

    .mic-btn.active::after {
      content: '';
      position: absolute;
      inset: -4px;
      border-radius: 50%;
      border: 2px solid #dc2626;
      animation: pulse 1s infinite;
      opacity: .5;
    }

    @keyframes typingBounce {

      0%,
      100% {
        transform: translateY(0);
      }

      50% {
        transform: translateY(-3px);
      }
    }

    @keyframes fadeInBtn {
      from {
        opacity: 0;
        transform: translateY(8px) scale(0.95);
      }

      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    @media (max-width: 768px) {
      .nav-bar {
        padding: 0 16px;
        height: 64px;
      }

      .nav-logo-text {
        font-size: 16px;
      }

      .auth-user {
        gap: 8px;
      }

      .user-name {
        display: none;
      }

      /* Competency Screen */
      .comp-header {
        flex-direction: column;
        align-items: flex-start;
        gap: 16px;
        padding: 16px;
      }

      .comp-progress-ring {
        align-self: center;
      }

      .comp-filters {
        flex-direction: column;
        align-items: stretch;
      }

      /* Mode of Study */
      .mode-body {
        padding: 20px;
      }

      .modes-grid {
        grid-template-columns: 1fr;
      }

      /* Video Player */
      .video-main {
        flex-direction: column;
      }

      .video-sidebar {
        width: 100%;
        border-left: none;
        border-top: 1px solid #e2e8f0;
        height: auto;
        max-height: 400px;
      }

      .video-area {
        height: 300px;
        flex: none;
      }

      /* Clinical Practice */
      .clin-main {
        grid-template-columns: 1fr;
        overflow-y: auto;
      }

      .clin-sidebar {
        border-right: none;
        height: auto;
        max-height: 400px;
        padding-bottom: 20px;
      }

      .clin-chat-area {
        height: 500px;
        border-top: 2px solid var(--border);
      }

      /* Evaluation */
      .eval-body {
        padding: 16px;
      }

      .eval-mode-cards {
        grid-template-columns: 1fr;
      }

      /* Modals */
      .docbot-panel {
        width: calc(100% - 32px);
        right: 16px;
        bottom: 80px;
        height: 60vh;
      }
    }

    @media (max-width: 480px) {
      .subjects-grid {
        grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
      }

      .welcome-card {
        flex-direction: column;
        align-items: flex-start;
        gap: 20px;
      }

      .year-wrap {
        text-align: left;
        width: 100%;
      }

      .year-select {
        width: 100%;
      }

      .sum-card {
        padding: 10px;
      }

      .sum-icon {
        width: 32px;
        height: 32px;
        font-size: 16px;
      }

      .sum-val {
        font-size: 13px;
      }

      .btn-submit-diag-green span {
        display: none;
      }
    }
  </style>
</head>

